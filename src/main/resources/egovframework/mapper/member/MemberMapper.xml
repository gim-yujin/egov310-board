<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="egovframework.example.board.member.service.impl.MemberDAO">

    <resultMap id="memberResult" type="memberVO">
        <id     property="memberId"   column="member_id"/>
        <result property="password"   column="password"/>
        <result property="memberName" column="member_name"/>
        <result property="email"      column="email"/>
        <result property="role"       column="role"/>
        <result property="regDt"      column="reg_dt"/>
    </resultMap>

    <insert id="insertMember" parameterType="memberVO">
        INSERT INTO tb_member (member_id, password, member_name, email, role)
        VALUES (#{memberId}, #{password}, #{memberName}, #{email}, #{role})
    </insert>

    <select id="selectMemberById" resultMap="memberResult">
        SELECT member_id, password, member_name, email, role, reg_dt
        FROM tb_member
        WHERE member_id = #{memberId}
    </select>

    <select id="countById" resultType="int">
        SELECT COUNT(*) FROM tb_member WHERE member_id = #{memberId}
    </select>

</mapper>
